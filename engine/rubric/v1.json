      "versionToken": "\\bv?\\d+\\.\\d+(?:\\.\\d+)?(?:[-+][A-Za-z0-9.]+)?\\b|\\bDEP\\d{4}\\b|\\bCVE-\\d{4}-\\d+\\b",
      "identifierToken": "`[^`]+`|\\b[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+\\b|\\b[a-z][a-z0-9]*(?:-[a-z0-9]+)+\\b",
      "dateToken": "\\b(19|20)\\d{2}-\\d{2}(-\\d{2})?\\b|\\b(January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},?\\s+(19|20)\\d{2}\\b",
      "urlToken": "https?://\\S+",
