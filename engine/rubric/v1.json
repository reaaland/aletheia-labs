  "conflictPolicy": {
    "rule": "surface_never_average",
    "statement": "When independent sources disagree about the same proposition the disagreement is reported as a conflict with both sides quoted. The engine never averages opposing claims into a single number; the losing side is carried in the report as dissent.",
    "confidencePenaltyPerConflict": 0.12,
    "maxConfidencePenalty": 0.5,
    "valueConflictPenaltyPerConflict": 0.06
  },
  "confidenceModel": {
    "$comment": "Deterministic. The reasoner supplies prose only; every number below is computed here from recorded inputs so a human can recompute the confidence by hand.",
    "base": "primary_group_score",
    "factors": {
      "coverage": {
        "type": "step_by_independent_domains",
        "points": [
          {
            "domains": 0,
            "factor": 0.4
          },
          {
            "domains": 1,
            "factor": 0.7
          },
          {
            "domains": 2,
            "factor": 0.9
          },
          {
            "domains": 3,
            "factor": 1.0
          }
        ],
        "above": 1.0
      },
      "authority": {
        "type": "categorical_floor",
        "statement": "If no supporting claim comes from primary_documentation, standards_spec or first_party_changelog, the score is multiplied by this factor.",
        "noAuthoritativeSourceFactor": 0.75
      },
      "retrieval": {
        "type": "availability",
        "statement": "If more than a third of the configured retrieval adapters were unavailable or failed, the score is multiplied by this factor.",
        "unavailableRatioThreshold": 0.34,
        "degradedFactor": 0.8
      }
    },
    "bands": [
      {
        "min": 0.8,
        "label": "high"
      },
      {
        "min": 0.6,
        "label": "moderate"
      },
      {
        "min": 0.4,
        "label": "low"
      },
      {
        "min": 0.0,
        "label": "very_low"
      }
    ]
  },
  "reporting": {
    "maxClaimsPerGroup": 6,
    "maxSourcesShown": 24,
    "citationStyle": "[S<n>]"
  },
  "selection": {
    "$comment": "How the engine picks the group of claims that forms the verdict. Relevance to the question is a gate, not a tiebreaker: an irrelevant claim is never the answer no matter how well sourced it is.",
    "rankKey": "relevance * score",
    "relevanceDefinition": "max over the group's claims of questionOverlap, where questionOverlap = |claim terms \u2229 question terms| / |question terms| after stopword removal and light stemming",
    "requireRelevanceAbove": 0.0,
    "tieBreak": [
      "score",
      "independentDomainCount",
      "clusterId"
    ],
