{
  "$comment": "Aletheia Labs evidence-grading rubric. Versioned data file. Dimensions are weighted; weights MUST sum to 1.0. Every dimension lists the exact raw inputs a human needs to recompute a score by hand. Editing this file is how you change the rubric -- never change scoring in code.",
  "id": "aletheia-rubric",
  "version": "1.0.0",
  "released": "2026-10-09",
  "weightsSum": 1.0,
  "dimensions": {
    "sourceClass": {
      "weight": 0.35,
      "kind": "categorical",
      "question": "How authoritative is the channel that made this claim?",
      "scale": {
        "standards_spec": 1.0,
        "primary_documentation": 0.9,
        "first_party_changelog": 0.8,
        "vendor_blog": 0.6,
        "qa_forum": 0.4,
        "aggregator": 0.3,
        "unknown": 0.2
      },
      "unknownKey": "unknown",
      "recompute": "Look up scores[sourceClass].ruleId from sourceClassRules, read the class, then read scale[class]."
    },
    "corroboration": {
      "weight": 0.25,
      "kind": "numeric",
      "question": "How many *independent* sources assert this same proposition?",
      "independentBy": "registrable_domain",
      "curve": {
        "type": "step_by_independent_domains",
        "points": [
          {
            "domains": 0,
            "score": 0.0
          },
          {
            "domains": 1,
            "score": 0.35
          },
          {
            "domains": 2,
            "score": 0.7
          },
          {
            "domains": 3,
            "score": 0.9
          },
          {
            "domains": 4,
            "score": 1.0
          }
        ],
        "above": 1.0
      },
      "recompute": "Count distinct registrable domains among claims in the same cluster AND the same polarity. Read curve.points for that count (values above the last point use 'above')."
    },
    "recency": {
      "weight": 0.2,
      "kind": "numeric",
      "question": "How fresh is the evidence?",
      "curve": {
        "type": "exponential_decay",
        "halfLifeDays": 540,
        "floor": 0.1
      },
      "unknownScore": 0.35,
      "recompute": "ageDays = (runDate - sourceDate) in days. score = max(floor, 0.5 ^ (ageDays / halfLifeDays)). If the source has no date, score = unknownScore and inputs.dateSource = 'unknown'."
    },
    "specificity": {
      "weight": 0.2,
      "kind": "numeric",
      "question": "Does the claim say something concrete enough to be checked?",
      "signals": {
        "versionToken": 0.3,
        "identifierToken": 0.25,
        "dateToken": 0.2,
        "urlToken": 0.15,
        "numericToken": 0.1
      },
      "cap": 1.0,
      "recompute": "Add the weight of every signal present in the claim text, cap at cap. inputs.matchedSignals lists exactly which signals fired."
    }
  },
  "sourceClassRules": {
    "$comment": "Ordered, first match wins. Applies to the source URL. host = lowercase hostname; path = full path. Rules are data, so a human can audit why a source got its class. 'upgrade' rules run first and override a later match.",
    "upgrade": [
      {
        "id": "spec-ietf",
        "class": "standards_spec",
        "host": "(^|\\.)(rfc-editor\\.org|ietf\\.org|w3\\.org|iso\\.org|ecma-international\\.org|unicode\\.org|whatwg\\.org)$"
      },
      {
        "id": "spec-path-tr",
        "class": "standards_spec",
        "host": "(^|\\.)(w3\\.org)$",
        "path": "^/TR/"
      },
      {
        "id": "changelog-path",
        "class": "first_party_changelog",
        "path": "(changelog|releases?|CHANGES|NEWS)"
      },
      {
        "id": "official-docs-host",
        "class": "primary_documentation",
        "host": "(^|\\.)(nodejs\\.org|docs\\.python\\.org|developer\\.mozilla\\.org|go\\.dev|doc\\.rust-lang\\.org|kernel\\.org|postgresql\\.org|docs\\.docker\\.com|kubernetes\\.io|man7\\.org|openssl\\.org|nginx\\.org)$"
      },
      {
        "id": "docs-subdomain",
        "class": "primary_documentation",
        "host": "^docs?\\."
      },
      {
        "id": "registry-host",
        "class": "primary_documentation",
        "host": "(^|\\.)(registry\\.npmjs\\.com|npmjs\\.com|pypi\\.org|files\\.pythonhosted\\.org|search\\.maven\\.org|crates\\.io|rubygems\\.org|packagist\\.org)$"
      },
      {
        "id": "vcs-host",
        "class": "primary_documentation",
        "host": "(^|\\.)(github\\.com|gitlab\\.com|codeberg\\.org|sourcehut\\.org|api\\.github\\.com)$"
      },
      {
        "id": "qa-host",
        "class": "qa_forum",
        "host": "(^|\\.)(stackoverflow\\.com|stackexchange\\.com|superuser\\.com|serverfault\\.com|askubuntu\\.com|reddit\\.com|news\\.ycombinator\\.com|discourse\\.|discuss\\.)"
      },
      {
        "id": "vendor-blog-host",
        "class": "vendor_blog",
        "host": "(^|\\.)(medium\\.com|dev\\.to|substack\\.com|hashnode\\.dev|infoq\\.com|thenewstack\\.io)$"
      },
      {
        "id": "vendor-blog-path",
        "class": "vendor_blog",
        "path": "/(blog|blogs|news|press)/"
      },
      {
        "id": "aggregator-host",
        "class": "aggregator",
        "host": "(^|\\.)(wikipedia\\.org|wikidata\\.org|hn\\.algolia\\.com|marginalia-search\\.com|search\\.marginalia\\.nu|stackexchange\\.com)$"
      }
    ],
    "default": "unknown",
    "notes": [
      "A first_party_changelog is a release note published by the project that owns the software, so it ranks below stable reference docs but above a blog post.",
      "Rule ids are recorded verbatim on every source, so any class assignment can be traced."
    ]
  },
