# Dependencies
node_modules/

# Local state: the evidence ledger and any database file are local, regenerable state.
*.db
*.sqlite
*.sqlite3

# Run evidence: screenshots and traces are large binaries regenerated by each run.
# The ledger records their paths, so a run stays reproducible without committing them.
artifacts/
**/artifacts/
traces/
*.trace.zip

# Secrets — the engine requires none, and none should ever land here.
.env
.env.*

# SEALED — the fixture answer key must NEVER be committed.
# It lives outside this repository (/home/team/shared/fixture-answer-key) and is the
# only thing that makes the blind test blind. This repository is public: a leaked key
# would not just spoil one run, it would spoil the fixture permanently and in the open.
fixture-answer-key/
**/ANSWER-KEY.md
*answer-key*
